# Legion Runtime — standalone process. DATABASE_URL is normally picked up automatically from
# ../backend/.env (both processes share one Postgres database); you only need this file for
# RUNTIME_*-specific overrides, or to point Runtime at a different database in an unusual setup.

# Internal HTTP API. Loopback by default — this is not meant to be reachable from outside this host.
# RUNTIME_PORT=4200
# RUNTIME_HOST=127.0.0.1

# Optional shared-secret header check for Server -> Runtime calls. Leave unset for local dev (open
# on loopback). If set, backend/.env's RUNTIME_INTERNAL_TOKEN must match exactly.
# RUNTIME_INTERNAL_TOKEN=

# Only needed if Runtime should use a DIFFERENT database than ../backend/.env's DATABASE_URL.
# DATABASE_URL=
