# LS-100 simulation profile — a local backend process that behaves like a commissioned LS-100 for
# development/testing, on its OWN database and port so it can run at the same time as the
# `engineering` profile backend. Copy to `backend/.env.ls100-sim` and run with:
#   LEGION_PROFILE=ls100-sim npm run dev   (from backend/)
# See backend/docs/deployment-profiles.md.

# A SEPARATE Postgres database from the engineering profile's DATABASE_URL — never point both
# profiles at the same database, or "one Site per LS-100" and the Engineering project history
# will collide in the same tables.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/legion_ls100_sim?schema=public"

# A different port so both backends can run simultaneously.
PORT=4100

LEGION_PROFILE=ls100-sim

# Optional in this profile (see deployment.auth.js) — set it to also exercise the auth boundary
# locally, or leave unset to accept unauthenticated deployment requests with a loud console warning.
# LS100_DEPLOY_TOKEN=dev-shared-secret

# LSPKG_STAGING_DIR=
