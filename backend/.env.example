# This is the `engineering` profile's env file (plain `backend/.env`, loaded whenever
# LEGION_PROFILE is unset — the default, unchanged single-process workflow). See
# backend/docs/deployment-profiles.md for the ls100-sim / ls100-production profiles, which each
# load their own backend/.env.ls100-sim / backend/.env.ls100-production instead of this file.

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/legion?schema=public"

# API server port
PORT=4000

# prisma/seed.js — Demo Campus owner (site creator + UserSiteAccess site_admin)
# SEED_OWNER_EMAIL=reydel@legion.local
# SEED_OWNER_NAME=Reydel Gutierrez
# DEMO_CAMPUS_SITE_ID=cafe0000-0000-4000-8000-00000000babe
# SEED_DEMO_SITES=false

# LC-ARCH-002 §10 deployment profile. Omit for the existing engineering/dev workflow (default).
# LEGION_PROFILE=engineering

# Shared-secret bearer token this backend requires on deployment endpoints when acting as the
# *sending* side (direct deploy) or, for an ls100-production profile, the *receiving* side.
# See backend/docs/deployment-profiles.md and backend/src/modules/deployment/deployment.auth.js.
# LS100_DEPLOY_TOKEN=

# Where staged/imported .lspkg bytes are written on disk (default: backend/.lspkg-staging).
# LSPKG_STAGING_DIR=
