generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SiteVersionStatus {
  WORKING
  RELEASED
  ARCHIVED
}

model Site {
  id               String       @id @default(uuid())
  name             String
  status           EntityStatus @default(ACTIVE)
  /// Engineering / Site Builder metadata (persisted; working-version sync reads these)
  timezone         String?
  siteType         String?
  description      String?
  displayLabel     String?
  engineeringNotes String?
  icon             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  /// User who created the site (shown as project owner in UIs that filter by creator)
  createdByUserId String?
  createdByUser   User?   @relation("SitesCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  activeReleaseVersionId String?      @unique
  activeReleaseVersion   SiteVersion? @relation("ActiveRelease", fields: [activeReleaseVersionId], references: [id], onDelete: SetNull)

  buildings              Building[]
  equipment              Equipment[]
  points                 Point[]
  userSiteAccess         UserSiteAccess[]
  siteVersions           SiteVersion[]
  alarmDefinitions       AlarmDefinition[]
  alarmEvents            AlarmEvent[]
  controllersMapped      ControllersMapped[]
  trendDefinitions       TrendDefinition[]
  trendAssignments       TrendAssignment[]
  scheduleDefinitions    ScheduleDefinition[]
  scheduleAssignments    ScheduleAssignment[]
  deploymentEvents       SiteDeploymentEvent[]
  liveControllerBindings LiveControllerBinding[]
}

model SiteVersion {
  id                     String            @id @default(uuid())
  siteId                 String
  versionNumber          Int
  status                 SiteVersionStatus
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  /// Who built/saved this version (WORKING edits or the BUILD RELEASE action).
  createdBy              String?
  /// Set the moment this RELEASED version last became the active release (deploy or rollback).
  /// Convenience cache of the most recent activation only — `SiteDeploymentEvent` is the
  /// authoritative, append-only activation history (repeated deploy/rollback never overwrites it).
  deployedAt             DateTime?
  /// Who last activated this RELEASED version (deploy or rollback) — distinct from createdBy.
  deployedBy             String?
  /// For a RELEASED version: the prior RELEASED version it superseded (null for the first release).
  /// For a WORKING version: the RELEASED version it was seeded from. Never points at a mutable
  /// WORKING row — release lineage must chain release-to-release only.
  parentVersionId        String?
  /// RELEASED only: the WORKING row whose content this release was built from (provenance, not
  /// lineage — a WORKING row keeps evolving after being built from, so this is informational only).
  sourceWorkingVersionId String?
  notes                  String?

  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent               SiteVersion?          @relation("VersionHierarchy", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children             SiteVersion[]         @relation("VersionHierarchy")
  sourceWorkingVersion SiteVersion?          @relation("ReleaseSourceWorking", fields: [sourceWorkingVersionId], references: [id], onDelete: SetNull)
  builtReleases        SiteVersion[]         @relation("ReleaseSourceWorking")
  payload              SiteVersionPayload?
  activeReleaseForSite Site?                 @relation("ActiveRelease")
  deploymentEvents     SiteDeploymentEvent[]

  @@unique([siteId, versionNumber])
  @@index([siteId])
  @@index([status])
  @@index([siteId, status])
}

enum SiteDeploymentAction {
  DEPLOY
  ROLLBACK
}

/// Append-only activation ledger (LC-ARCH-003 Phase 1.1): the authoritative history of which
/// RELEASED SiteVersion was active when. `Site.activeReleaseVersionId` remains the authoritative
/// CURRENT pointer; this table exists so repeated deploy/rollback of the same release never
/// destroys the ability to reconstruct "what was live, and when" or to derive "the previous release"
/// correctly (a mutable last-activated timestamp on the immutable release row cannot do either).
model SiteDeploymentEvent {
  id                       String               @id @default(uuid())
  /// Monotonic append order — the authoritative ordering for "what happened when". `activatedAt`
  /// is wall-clock metadata only: several activations can land in the same millisecond (fast
  /// sequential deploy/rollback calls, coarse OS clock resolution), which would otherwise make
  /// "previous release" derivation ambiguous. This can never tie.
  sequence                 Int                  @default(autoincrement())
  siteId                   String
  releaseVersionId         String
  /// The release that was active immediately before this event (null for a site's first-ever deploy).
  previousReleaseVersionId String?
  action                   SiteDeploymentAction
  activatedAt              DateTime             @default(now())
  activatedBy              String?

  site    Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  release SiteVersion @relation(fields: [releaseVersionId], references: [id], onDelete: Cascade)

  @@index([siteId, sequence])
  @@index([releaseVersionId])
}

model SiteVersionPayload {
  id            String @id @default(uuid())
  siteVersionId String @unique
  payloadJson   Json

  siteVersion SiteVersion @relation(fields: [siteVersionId], references: [id], onDelete: Cascade)
}

model Building {
  id           String       @id @default(uuid())
  siteId       String
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  latitude     Float?
  longitude    Float?
  status       EntityStatus @default(ACTIVE)
  buildingType String?
  buildingCode String?
  /// Operator building page hero / tagline (optional; falls back to site description)
  description  String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  floors            Floor[]
  equipment         Equipment[]
  points            Point[]
  controllersMapped ControllersMapped[]

  @@unique([siteId, name])
}

model Floor {
  id            String       @id @default(uuid())
  buildingId    String
  name          String
  status        EntityStatus @default(ACTIVE)
  /// Operator / Site Builder display name (falls back to name when unset)
  displayLabel  String?
  floorType     String?
  occupancyType String?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  building          Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipment         Equipment[]
  points            Point[]
  controllersMapped ControllersMapped[]

  @@unique([buildingId, name])
}

model Equipment {
  id             String       @id @default(uuid())
  siteId         String
  buildingId     String
  floorId        String
  name           String
  code           String
  equipmentType  String
  /// Optional template label from Template Library (engineering)
  templateName   String?
  /// BACnet / controller-style address for mapping (user-entered in Site Builder)
  address        String?
  /// User-defined instance / tag (unique per site when set; Site Builder)
  instanceNumber String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  site                  Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  building              Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor                 Floor                  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  points                Point[]
  alarmDefinitions      AlarmDefinition[]
  alarmEvents           AlarmEvent[]
  controllersMapped     ControllersMapped?
  pointsMapped          PointsMapped[]
  trendAssignments      TrendAssignment[]
  scheduleAssignments   ScheduleAssignment[]
  liveControllerBinding LiveControllerBinding?

  @@unique([siteId, code])
  @@unique([siteId, instanceNumber])
}

/// Persisted assignment of a discovered field controller to one Legion equipment row (Phase 2).
/// Renamed from EquipmentController: one row per equipment; `controllerCode` is unique per site (not globally).
model ControllersMapped {
  id             String    @id @default(uuid())
  equipmentId    String    @unique
  controllerCode String
  displayName    String?
  protocol       String
  deviceInstance String?
  ipAddress      String?
  networkAddress String?
  siteId         String
  buildingId     String?
  floorId        String?
  pollRateMs     Int?      @default(5000)
  isSimulated    Boolean   @default(false)
  isEnabled      Boolean   @default(true)
  status         String?
  lastSeenAt     DateTime?
  metadataJson   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  building     Building?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor        Floor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  equipment    Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  pointsMapped PointsMapped[]

  @@unique([siteId, controllerCode])
  @@index([controllerCode])
  @@index([siteId])
}

/// Maps a runtime / field point key to a Legion Point row for a given assigned controller (Phase 2).
/// Renamed from PointMapping.
model PointsMapped {
  id                    String   @id @default(uuid())
  equipmentControllerId String
  equipmentId           String
  pointId               String
  legionPointCode       String?
  fieldPointKey         String
  fieldPointName        String?
  fieldObjectType       String?
  fieldObjectInstance   String?
  fieldDataType         String?
  readEnabled           Boolean  @default(true)
  writeEnabled          Boolean  @default(false)
  isBound               Boolean  @default(true)
  metadataJson          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  controllersMapped ControllersMapped @relation(fields: [equipmentControllerId], references: [id], onDelete: Cascade)
  equipment         Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  point             Point             @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([equipmentControllerId, fieldPointKey])
  @@unique([equipmentControllerId, pointId])
  @@index([equipmentId])
  @@index([pointId])
}

// -------------------------------------------------------------------------------------------
// LC-ARCH-003 Phase 1.1: Live runtime-facing projection of controller/point bindings.
// `ControllersMapped`/`PointsMapped` above are Engineering-authored (mutable, edited directly by
// Site Builder / Point Mapping) and must never be read by Runtime — that was the Phase 1 boundary
// gap. `LiveControllerBinding`/`LivePointBinding` are the deployed projection: populated only by
// `deployRelease`'s materialization step (see `runtime/liveConfig.service.js`), sourced from the
// RELEASED SiteVersion's own frozen `controllerBindings`/`pointBindings` payload (captured at BUILD
// time from ControllersMapped/PointsMapped), never from whatever those tables say *now*. Runtime
// polling (`runtime.service.js`) reads and writes ONLY these tables, never ControllersMapped/
// PointsMapped directly.
// -------------------------------------------------------------------------------------------

/// One row per equipment with a controller binding in the currently active release.
model LiveControllerBinding {
  id               String    @id @default(uuid())
  siteId           String
  equipmentId      String    @unique
  controllerCode   String
  displayName      String?
  protocol         String
  deviceInstance   String?
  ipAddress        String?
  networkAddress   String?
  buildingId       String?
  floorId          String?
  pollRateMs       Int?      @default(5000)
  isSimulated      Boolean   @default(false)
  isEnabled        Boolean   @default(true)
  /// Runtime communication heartbeat — set by `runtime.service.js`, never by deploy/materialization.
  status           String?
  lastSeenAt       DateTime?
  /// Which RELEASED SiteVersion currently backs this binding (debugging/traceability only).
  releaseVersionId String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site          Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipment     Equipment               @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  pointBindings LivePointBinding[]
  runtimeState  ControllerRuntimeState?

  @@index([siteId])
  @@index([controllerCode])
}

// -------------------------------------------------------------------------------------------
// LC-ARCH-004 Phase 2: runtime-state ownership. `LiveControllerBinding`/`Point` above remain
// (deployed) CONFIGURATION — identity, mapping, engineering metadata. `ControllerRuntimeState`/
// `PointRuntimeState` are what the standalone Runtime process actually owns and writes every poll:
// communication health, present value, and explicit quality. Kept as separate 1:1 tables rather than
// extra columns so Runtime's write path never touches a config row, and so a comms failure can never
// make a point "disappear" — only its quality changes, never its configuration identity.
//
// Phase 2 compatibility note: Runtime still mirrors into the legacy `Point.presentValue/commState/
// lastSeenAt` and `LiveControllerBinding.status/lastSeenAt` columns so existing consumers (alarm
// evaluation, historian, Site Builder/Operator read paths) keep working unchanged. Migrating those
// consumers onto these tables directly is deferred to Phase 3.
// -------------------------------------------------------------------------------------------

enum PointQuality {
  GOOD
  STALE
  COMM_FAILURE
  OUT_OF_SERVICE
  OVERRIDDEN
  UNRELIABLE
  UNKNOWN
}

model ControllerRuntimeState {
  id                      String       @id @default(uuid())
  liveControllerBindingId String       @unique
  status                  String?
  quality                 PointQuality @default(UNKNOWN)
  lastSeenAt              DateTime?
  lastPollAt              DateTime?
  failureCount            Int          @default(0)
  updatedAt               DateTime     @updatedAt
  createdAt               DateTime     @default(now())

  liveControllerBinding LiveControllerBinding @relation(fields: [liveControllerBindingId], references: [id], onDelete: Cascade)
}

model PointRuntimeState {
  id           String       @id @default(uuid())
  pointId      String       @unique
  presentValue String?
  quality      PointQuality @default(UNKNOWN)
  /// Protocol driver that produced this value (e.g. "SIM", "BACNET_IP") — LC-ARCH-004 protocol boundary.
  source       String?
  lastSeenAt   DateTime?
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
}

/// Maps a runtime/field point key to a Legion Point row, mirroring the active release's PointsMapped
/// snapshot for one `LiveControllerBinding`.
model LivePointBinding {
  id                      String   @id @default(uuid())
  liveControllerBindingId String
  equipmentId             String
  pointId                 String
  legionPointCode         String?
  fieldPointKey           String
  fieldPointName          String?
  fieldObjectType         String?
  fieldObjectInstance     String?
  fieldDataType           String?
  readEnabled             Boolean  @default(true)
  writeEnabled            Boolean  @default(false)
  isBound                 Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  controllerBinding LiveControllerBinding @relation(fields: [liveControllerBindingId], references: [id], onDelete: Cascade)
  point             Point                 @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([liveControllerBindingId, fieldPointKey])
  @@unique([liveControllerBindingId, pointId])
  @@index([equipmentId])
  @@index([pointId])
}

enum AlarmSeverity {
  CRITICAL
  MAJOR
  MINOR
  WARNING
}

enum AlarmRuleCategory {
  BINARY
  THRESHOLD
  DEVIATION
  COMPARISON
}

enum AlarmOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IS_ON
  IS_OFF
  DELTA_GT
  DELTA_GTE
  DELTA_LT
  DELTA_LTE
}

enum AlarmEventState {
  ACTIVE
  CLEARED
}

model Point {
  id           String       @id @default(uuid())
  equipmentId  String
  siteId       String
  buildingId   String
  floorId      String
  pointName    String
  pointCode    String
  pointType    String
  unit         String?
  writable     Boolean      @default(false)
  presentValue String?
  /// Last time a field/runtime poll successfully refreshed this point (SIM or future protocols).
  lastSeenAt   DateTime?
  /// Runtime comms layer: ONLINE | OFFLINE | UNKNOWN (distinct from EntityStatus `status`).
  commState    String?      @default("UNKNOWN")
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  building  Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor     Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)

  alarmDefinitionsAsSource AlarmDefinition[]    @relation("AlarmDefinitionSourcePoint")
  alarmDefinitionsAsTarget AlarmDefinition[]    @relation("AlarmDefinitionTargetPoint")
  alarmEvents              AlarmEvent[]         @relation("AlarmEventPoint")
  pointsMapped             PointsMapped[]
  historySamples           PointHistorySample[]
  livePointBindings        LivePointBinding[]
  runtimeState             PointRuntimeState?

  @@unique([equipmentId, pointCode])
}

/// Point-level historian sample (LC-ARCH-001 D-010: stale/offline points remain represented in
/// trends; history is never fabricated). Written by any runtime write path (SIM poll today,
/// real BACnet/IP and MS/TP polling later) via the shared historian helper, so trends, and any
/// future analytics, read from one persisted timeline per point rather than a per-trend copy.
model PointHistorySample {
  id        String   @id @default(uuid())
  pointId   String
  timestamp DateTime @default(now())
  /// Raw presentValue string at sample time; null only if a write explicitly records "no value"
  /// (never used to fabricate a reading — absence of a row IS the gap).
  value     String?
  /// Communication quality at sample time: ONLINE | OFFLINE | STALE. Independent of alarm state.
  quality   String   @default("ONLINE")

  point Point @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId, timestamp])
  /// Retention cleanup sweeps by timestamp alone across all points; the composite index above
  /// doesn't serve that scan pattern (pointId is its leading column).
  @@index([timestamp])
}

/// Durable site-scoped trend definition. Point requirements are semantic JSON so templates
/// can be resolved independently for each equipment assignment.
model TrendDefinition {
  id                String   @id @default(uuid())
  siteId            String
  name              String
  enabled           Boolean  @default(true)
  isTemplate        Boolean  @default(false)
  equipmentType     String?
  sampleInterval    Int?
  /// Historian retention window for this trend's points, in days. Additive/nullable so existing
  /// rows default without a backfill; a cleanup job can read it once one exists.
  retentionDays     Int?     @default(30)
  pointRequirements Json
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignments TrendAssignment[]

  @@index([siteId, isTemplate])
}

model TrendAssignment {
  id               String   @id @default(uuid())
  definitionId     String
  siteId           String
  equipmentId      String
  enabled          Boolean  @default(true)
  resolvedMappings Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  definition TrendDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  site       Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([definitionId, equipmentId])
  @@index([siteId, equipmentId])
}

model ScheduleDefinition {
  id            String   @id @default(uuid())
  siteId        String
  name          String
  enabled       Boolean  @default(true)
  isTemplate    Boolean  @default(false)
  weeklyWindows Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site        Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignments ScheduleAssignment[]

  @@index([siteId, isTemplate])
}

model ScheduleAssignment {
  id           String   @id @default(uuid())
  definitionId String
  siteId       String
  equipmentId  String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition ScheduleDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipment  Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([definitionId, equipmentId])
  @@index([siteId, equipmentId])
}

model AlarmDefinition {
  id              String            @id @default(uuid())
  siteId          String
  buildingId      String?
  floorId         String?
  equipmentId     String
  /// Stable template / logical point key (e.g. zoneTemp); source of truth with equipmentId.
  pointKey        String
  /// Optional bound Point row when mapped in DB; may be null until discovery/mapping.
  pointId         String?
  name            String
  enabled         Boolean           @default(true)
  severity        AlarmSeverity     @default(WARNING)
  category        AlarmRuleCategory
  operator        AlarmOperator
  targetValue     Float?
  targetPointId   String?
  /// Logical reference on same equipment when target Point is not bound yet.
  targetPointKey  String?
  deadband        Float?
  delaySeconds    Int?
  messageTemplate String?
  autoAcknowledge Boolean           @default(false)
  /// Generic persisted condition tree. Leaves reference logical point keys on this equipment.
  conditionTree   Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipment   Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  point       Point?       @relation("AlarmDefinitionSourcePoint", fields: [pointId], references: [id], onDelete: SetNull)
  targetPoint Point?       @relation("AlarmDefinitionTargetPoint", fields: [targetPointId], references: [id], onDelete: SetNull)
  events      AlarmEvent[]

  @@index([siteId])
  @@index([equipmentId])
  @@index([pointId])
  @@index([siteId, equipmentId, pointKey])
  @@index([siteId, enabled])
}

model AlarmEvent {
  id                String          @id @default(uuid())
  alarmDefinitionId String
  siteId            String
  equipmentId       String
  pointId           String
  state             AlarmEventState @default(ACTIVE)
  ack               Boolean         @default(false)
  occurredAt        DateTime        @default(now())
  clearedAt         DateTime?
  lastEvaluatedAt   DateTime?
  activeValue       String?
  clearValue        String?
  message           String
  durationSeconds   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition AlarmDefinition @relation(fields: [alarmDefinitionId], references: [id], onDelete: Cascade)
  site       Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  equipment  Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  point      Point           @relation("AlarmEventPoint", fields: [pointId], references: [id], onDelete: Cascade)

  @@index([siteId, state])
  @@index([alarmDefinitionId, state])
  @@index([equipmentId])
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  name      String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sitesCreated   Site[]           @relation("SitesCreatedByUser")
  userSiteAccess UserSiteAccess[]
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSiteAccess UserSiteAccess[]
}

model UserSiteAccess {
  id        String   @id @default(uuid())
  userId    String
  siteId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, siteId])
}

/// Company-wide equipment template definitions (import creates a site-local copy in working version).
model GlobalEquipmentTemplate {
  id                 String       @id @default(uuid())
  name               String
  equipmentType      String
  description        String       @default("")
  defaultGraphicName String?
  pointsJson         Json         @default("[]")
  status             EntityStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  graphicTemplates GlobalGraphicTemplate[]

  @@index([equipmentType])
  @@index([status])
}

model GlobalGraphicTemplate {
  id                        String       @id @default(uuid())
  name                      String
  appliesToEquipmentType    String
  globalEquipmentTemplateId String?
  equipmentTemplateName     String?
  graphicEditorStateJson    Json?
  boundPointCount           Int          @default(0)
  status                    EntityStatus @default(ACTIVE)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  globalEquipmentTemplate GlobalEquipmentTemplate? @relation(fields: [globalEquipmentTemplateId], references: [id], onDelete: SetNull)

  @@index([appliesToEquipmentType])
  @@index([status])
}

// -------------------------------------------------------------------------------------------
// LC-ARCH-002: Legion Site Package deployment (.lspkg). These models exist in the shared Prisma
// schema so one codebase serves both the `engineering` and `ls100-*` profiles (DATABASE_URL alone
// selects which physical database a process talks to — see backend/docs/deployment-profiles.md).
// They are meaningful (enforced) only when a backend process runs as an LS-100 profile; under the
// `engineering` profile they simply sit unused. This deliberately evolves/reuses SiteVersion as the
// activated-configuration ledger (see deployment.service.js) rather than inventing a second,
// competing version system.
// -------------------------------------------------------------------------------------------

enum LsCommissionState {
  UNCOMMISSIONED
  STAGED
  VALIDATED
  ACTIVATING
  ACTIVE
  FAILED
  ROLLBACK
}

enum DeploymentPackageStatus {
  STAGED
  VALIDATED
  ACTIVATING
  ACTIVE
  FAILED
  SUPERSEDED
  DISCARDED
}

enum DeploymentSource {
  DIRECT
  OFFLINE_IMPORT
}

enum DeploymentAuditResult {
  SUCCESS
  FAILURE
}

enum ControllerAppDeployStatus {
  PENDING
  TRANSFERRED
  VERIFIED
  FAILED
  NOT_APPLICABLE
}

/// Singleton row (fixed id "ls100") tracking this LS-100 instance's commissioning state (LC-ARCH-002
/// §5 state machine) and the one active Site it enforces (DEP-001). `activeSiteId` is set only after
/// a successful activation; recommissioning (archiving the current Site) clears it back to null.
model LsCommissioning {
  id                    String            @id @default("ls100")
  state                 LsCommissionState @default(UNCOMMISSIONED)
  activeSiteId          String?
  activePackageRecordId String?
  updatedAt             DateTime          @updatedAt
}

/// One row per .lspkg staged/imported on an LS-100 (DEP-005). The package bytes/manifest are
/// stored on disk under LSPKG_STAGING_DIR (see deployment.service.js); this row is the tracked
/// lifecycle/status record used by staging, validation, preview, activation and rollback.
model DeploymentPackageRecord {
  id                   String                  @id @default(uuid())
  packageId            String
  siteId               String
  siteName             String
  packageVersion       String
  schemaVersion        Int
  status               DeploymentPackageStatus @default(STAGED)
  source               DeploymentSource
  filePath             String
  checksumSha256       String
  manifestJson         Json
  changePreviewJson    Json?
  validationErrorsJson Json?
  receivedAt           DateTime                @default(now())
  validatedAt          DateTime?
  activatedAt          DateTime?
  supersededAt         DateTime?
  failureReason        String?
  /// SiteVersion created on successful activation (see deployment.service.js) — the pointer that
  /// makes SiteVersion.activeReleaseVersionId the actual Operator-visible "active configuration".
  createdSiteVersionId String?

  auditEntries DeploymentAuditEntry[]
  backups      DeploymentBackupRecord[]

  @@index([siteId])
  @@index([status])
}

/// Pre-deployment recoverable snapshot (DEP-005/DEP-006). Captures the previously active
/// SiteVersion payload plus a manifest of relational definition ids, so a failed or unwanted
/// activation can be rolled back without depending on anything in the new package.
model DeploymentBackupRecord {
  id              String   @id @default(uuid())
  siteId          String
  packageRecordId String?
  reason          String
  snapshotJson    Json
  createdAt       DateTime @default(now())

  packageRecord DeploymentPackageRecord? @relation(fields: [packageRecordId], references: [id], onDelete: SetNull)

  @@index([siteId])
}

/// Audit trail for build/transfer/import/validate/preview/backup/activate/rollback (LC-ARCH-002 §11).
model DeploymentAuditEntry {
  id              String                @id @default(uuid())
  siteId          String?
  packageRecordId String?
  action          String
  result          DeploymentAuditResult
  actor           String?
  detailsJson     Json?
  createdAt       DateTime              @default(now())

  packageRecord DeploymentPackageRecord? @relation(fields: [packageRecordId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([packageRecordId])
}

/// Tracks LPC controller-application deployment status separately from site-package activation
/// (DEP-007 — LCPE owns controller applications; activating a site package never claims a physical
/// controller received a program). Defaults to NOT_APPLICABLE because this repo has no LCPE
/// integration yet.
model ControllerApplicationDeployment {
  id                 String                    @id @default(uuid())
  siteId             String
  equipmentId        String?
  controllerCode     String
  applicationRef     String?
  applicationVersion String?
  status             ControllerAppDeployStatus @default(NOT_APPLICABLE)
  packageRecordId    String?
  notes              String?
  updatedAt          DateTime                  @updatedAt
  createdAt          DateTime                  @default(now())

  @@unique([siteId, controllerCode])
  @@index([siteId])
}

/// Staging cache for BACnet device discovery (not yet mapped to ControllersMapped).
model BacnetDevice {
  id             String    @id @default(uuid())
  deviceInstance Int
  address        String
  vendorId       Int?
  maxApdu        Int?
  segmentation   Int?
  protocol       String?
  objectName     String?
  modelName      String?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  discoveredObjects BacnetDiscoveredObject[]

  @@unique([deviceInstance, address])
  @@index([address])
}

/// Staging cache for BACnet objects discovered on a device (not yet mapped to PointsMapped).
model BacnetDiscoveredObject {
  id             String    @id @default(uuid())
  bacnetDeviceId String
  objectType     String
  objectTypeId   Int
  objectInstance Int
  objectName     String?
  description    String?
  presentValue   Json?
  units          String?
  outOfService   Boolean?
  reliability    String?
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bacnetDevice BacnetDevice @relation(fields: [bacnetDeviceId], references: [id], onDelete: Cascade)

  @@unique([bacnetDeviceId, objectTypeId, objectInstance])
  @@index([bacnetDeviceId])
}
