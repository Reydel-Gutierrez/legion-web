# LS-100 production profile template. This repo has no production deployment tooling beyond this
# env file and the honesty checks in deployment.auth.js/prisma/seed.js — see
# backend/docs/deployment-profiles.md "Production limitations" before using this for a real site.

# A dedicated, device-local operational database. Never share this with any engineering or
# ls100-sim database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/legion_ls100_production?schema=public"

PORT=4000
LEGION_PROFILE=ls100-production

# REQUIRED in this profile. deployment.auth.js refuses every deployment request with HTTP 501
# until this is set — there is no unauthenticated production deployment endpoint.
LS100_DEPLOY_TOKEN=

# prisma/seed.js refuses to run at all under this profile (see the guard at its top) — a
# production LS-100's Site comes only from a deployed .lspkg, never from a seed script.

# LSPKG_STAGING_DIR=
